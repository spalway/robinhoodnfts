# xCorp environment.
#
# ONLY three variables live here. Everything else — the $XAS token address, the
# project wallet, the treasury, the market links, the support handle — lives in
# the `protocol_config` table in Supabase, so it can be changed live without a
# redeploy. See supabase/migrations/20260806120000_protocol_config.sql.
#
# Why these stayed: they are what a browser needs in order to REACH that table.
# Config that told you where to find itself would be circular.
#
# Vite substitutes VITE_ variables at BUILD time. Changing one requires a
# rebuild and redeploy — restarting is not enough. That property is exactly why
# the addresses were moved out.

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The "anon / public" key. NEVER the service_role key — that one bypasses RLS
# entirely, and anything in a VITE_ variable is compiled into a file every
# visitor downloads.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Stock prices — nothing to configure
# ---------------------------------------------------------------------------
#
# The tape reads /api/stock-prices, a route on this project's own Node server
# (api/stock-prices.mjs, mounted by server.mjs and by the Vite dev server). It
# proxies Robinhood's public endpoints and needs no key.
#
# It is a proxy rather than a direct call for one measured reason:
# api.robinhood.com sends no Access-Control-Allow-Origin, so a browser refuses
# the response before the page can read it. Same-origin removes the question.

# ---------------------------------------------------------------------------
# Robinhood Chain RPC — NOT here
# ---------------------------------------------------------------------------
#
# There is no VITE_ RPC variable. The browser's RPC is `rpc_url` in the
# protocol_config row, alongside the token address and the project wallet, for
# the same reason they are: swapping providers during an outage must not require
# a rebuild and a redeploy.
#
# The Edge Function has its own, which IS a secret. Set these four in
# Project Settings -> Edge Functions -> Secrets, or:
#
#   npx supabase secrets set CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
#   npx supabase secrets set XAS_TOKEN_ADDRESS=0x...   # the $XAS ERC-20, once it exists
#   npx supabase secrets set TREASURY_ADDRESS=0x...
#   npx supabase secrets set DEV_WALLET_ADDRESS=0x...
#
# Until XAS_TOKEN_ADDRESS is set, confirm-mint answers 503 not-configured and
# writes nothing. That is deliberate: a verifier that cannot identify the token
# must never issue a serial.

# ---------------------------------------------------------------------------
# Admin desk
# ---------------------------------------------------------------------------

# SHA-256 of the /admin passcode. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR-PASSCODE').digest('hex'))"
#
# A digest, not the passcode, so the plaintext is not in the bundle. Be clear
# about what this buys: it hides the desk from casual visitors and nothing more.
# The control that actually holds is the project wallet's signature — no payout
# can be sent without it.
VITE_ADMIN_PASSCODE_SHA256=
