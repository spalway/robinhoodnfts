{
  "name": "xcorp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "xCorp — hire generative pixel xployees whose desks track Robinhood Stock Tokens on Robinhood Chain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-fonts.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "brand": "node scripts/brand.mjs",
    "start": "node server.mjs",
    "sql:split": "node scripts/split-sql.mjs",
    "sql:bundle": "node scripts/bundle-sql.mjs && node scripts/split-sql.mjs",
    "seed:genesis": "vite-node scripts/gen-genesis-seed.ts",
    "favicon": "vite-node scripts/gen-favicon.ts",
    "banner": "vite-node scripts/gen-banner.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tanstack/react-query": "^5.101.2",
    "buffer": "^6.0.3",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "docx": "^9.7.1",
    "jpeg-js": "^0.4.4",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
    "@rollup/rollup-linux-x64-gnu": "4.62.4",
    "@rollup/rollup-linux-x64-musl": "4.62.4",
    "@esbuild/linux-x64": "0.25.12"
  },
  "engines": {
    "node": ">=22"
  }
}
